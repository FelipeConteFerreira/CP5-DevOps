@model List<Cliente>
@{ ViewData["Title"] = "Clientes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="m-0">Clientes</h2>
  <a class="btn btn-dd" asp-action="Create">Novo cliente</a>
</div>
@if (!Model.Any()) { <p class="text-muted">Nenhum cliente ainda. Clique em “Novo cliente” para cadastrar o primeiro.</p> }
else {
<div class="table-responsive"><table class="table table-bordered align-middle">
  <thead><tr><th>Id</th><th>Nome</th><th>E-mail</th><th>Cadastro</th><th>Transações</th><th></th></tr></thead>
  <tbody>
  @foreach (var c in Model) {
    <tr>
      <td>@c.Id</td><td>@c.Nome</td><td>@c.Email</td><td>@c.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td><td>@c.Transacoes.Count</td>
      <td class="text-nowrap">
        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Excluir este cliente e suas transações?')">
          <button class="btn btn-sm btn-outline-danger">Excluir</button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table></div>
}
