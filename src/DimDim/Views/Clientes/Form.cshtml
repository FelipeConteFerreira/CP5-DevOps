@model Cliente
@{ var novo = Model.Id == 0; ViewData["Title"] = novo ? "Novo cliente" : "Editar cliente"; }
<h2>@ViewData["Title"]</h2>
<form asp-action="@(novo ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="col-md-6">
  <div class="mb-3"><label class="form-label" asp-for="Nome"></label><input class="form-control" asp-for="Nome" /><span class="text-danger" asp-validation-for="Nome"></span></div>
  <div class="mb-3"><label class="form-label" asp-for="Email">E-mail</label><input class="form-control" asp-for="Email" /><span class="text-danger" asp-validation-for="Email"></span></div>
  <button class="btn btn-dd">Salvar cliente</button>
  <a class="btn btn-link text-dark" asp-action="Index">Cancelar</a>
</form>
