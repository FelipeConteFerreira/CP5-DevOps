@model Transacao
@{ var novo = Model.Id == 0; ViewData["Title"] = novo ? "Nova transação" : "Editar transação"; }
<h2>@ViewData["Title"]</h2>
<form asp-action="@(novo ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" class="col-md-6">
  <div class="mb-3"><label class="form-label" asp-for="ClienteId">Cliente</label>
    <select class="form-select" asp-for="ClienteId" asp-items="(SelectList)ViewBag.Clientes"><option value="">Selecione...</option></select>
    <span class="text-danger" asp-validation-for="ClienteId"></span></div>
  <div class="mb-3"><label class="form-label" asp-for="Valor">Valor (R$)</label><input class="form-control" asp-for="Valor" type="number" step="0.01" min="0.01" /><span class="text-danger" asp-validation-for="Valor"></span></div>
  <div class="mb-3"><label class="form-label" asp-for="Descricao">Descrição</label><input class="form-control" asp-for="Descricao" /><span class="text-danger" asp-validation-for="Descricao"></span></div>
  <button class="btn btn-dd">Salvar transação</button>
  <a class="btn btn-link text-dark" asp-action="Index">Cancelar</a>
</form>
