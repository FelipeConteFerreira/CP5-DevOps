@model List<Transacao>
@{ ViewData["Title"] = "Transações"; var pt = new System.Globalization.CultureInfo("pt-BR"); }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="m-0">Transações</h2>
  <a class="btn btn-dd" asp-action="Create">Nova transação</a>
</div>
@if (!Model.Any()) { <p class="text-muted">Nenhuma transação ainda. Cadastre um cliente e depois clique em “Nova transação”.</p> }
else {
<div class="table-responsive"><table class="table table-bordered align-middle">
  <thead><tr><th>Id</th><th>Cliente</th><th>Valor</th><th>Descrição</th><th>Data</th><th></th></tr></thead>
  <tbody>
  @foreach (var t in Model) {
    <tr>
      <td>@t.Id</td><td>@t.Cliente.Nome</td><td>R$ @t.Valor.ToString("N2", pt)</td><td>@t.Descricao</td><td>@t.DataTransacao.ToString("dd/MM/yyyy HH:mm")</td>
      <td class="text-nowrap">
        <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@t.Id">Editar</a>
        <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" onsubmit="return confirm('Excluir esta transação?')">
          <button class="btn btn-sm btn-outline-danger">Excluir</button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table></div>
}
